# Copy to .env locally. Never commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_URL=http://127.0.0.1:4174
# Enable only with HTTPS production hosting.
COOKIE_SECURE=false

# Local testing only. Production always requires email verification.
LOCAL_AUTH_TEST=false
