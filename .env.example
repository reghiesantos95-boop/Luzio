# Copy to .env locally. Never commit real credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_URL=http://127.0.0.1:4174
# Enable only with HTTPS production hosting.
COOKIE_SECURE=false

# Local testing only. Production always requires email verification.
LOCAL_AUTH_TEST=true

# Development only: password-only login for a single active admin on localhost/LAN.
# Set false to require email + password during testing. Production always uses email.
ADMIN_PASSWORD_ONLY=false
# If multiple admins exist, choose one locally; leave empty for a single-admin project.
ADMIN_TEST_EMAIL=

# Draft: enable only after SMTP works. Requires a code for each new admin login.
ADMIN_LOGIN_EMAIL_VERIFICATION=false
